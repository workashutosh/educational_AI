# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgres://education:education@127.0.0.1:5432/education_ai

# Pilot: allow /ask-test/ to call /api/ask/ without login. FALSE on public VPS.
ALLOW_OPEN_ASK=True

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media (local disk for pilot; path layout is schools/{id}/buckets/{id}/...)
MEDIA_ROOT=media
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# LiteLLM → Google Gemini (optional / deferred PageIndex enrichment)
# ---------------------------------------------------------------------------
PAGEINDEX_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
PAGEINDEX_LLM_RPM=8
PAGEINDEX_WORKSPACE=media/pageindex_workspace

PADDLEOCR_VL_TOKEN=your-paddleocr-vl-token
PADDLEOCR_VL_MODEL=PaddleOCR-VL-1.6

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_MAX_CHARS=3200
CHUNK_OVERLAP_CHARS=320

# Chat LLM — DeepSeek preferred (https://api-docs.deepseek.com/)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Optional fallback if DEEPSEEK_API_KEY is empty
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# RAG harness (POST /api/harness/query/) — shared agent retrieval layer
RAG_HARNESS_TOP_K=5
RAG_HARNESS_MAX_CONTEXT_CHARS=12000

# Brevo transactional email (onboarding OTP + mock result release)
# Use a sender verified in your Brevo account.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@your-verified-domain
BREVO_SENDER_NAME=ClassKit
FRONTEND_BASE_URL=http://127.0.0.1:5173
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ONBOARD_PENDING_TTL_SECONDS=1800
ONBOARD_SETUP_TOKEN_TTL_SECONDS=1800

# Microsoft Graph / Teams (Lectures — create meeting links from the app)
# Preferred: delegated OAuth — teacher clicks “Connect Microsoft” on Lectures
# See lectures/SETUP_TEAMS.md
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REDIRECT_URI=http://127.0.0.1:8000/api/lectures/teams/callback/
MS_GRAPH_OAUTH_TENANT=organizations
# Optional app-only fallback (needs Teams application access policy)
MS_GRAPH_ORGANIZER_USER_ID=


# ---------------------------------------------------------------------------
# Retrieval backend: auto = pgvector when available (docker image
# pgvector/pgvector:pg16 + `manage.py migrate`), else brute-force JSON.
# After enabling pgvector on an existing DB: manage.py vector_index --backfill
# ---------------------------------------------------------------------------
RAG_VECTOR_BACKEND=auto
EMBEDDING_DIM=384
# Multilingual retrieval (Hindi/Tamil/… questions without translation):
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MULTILINGUAL=True   then: manage.py vector_index --reembed
EMBEDDING_MULTILINGUAL=False

# Speech-to-text (voice questions + lecture recordings). Defaults to Groq
# Whisper using GROQ_API_KEY; any OpenAI-compatible /audio/transcriptions works.
# Install ffmpeg on the server to transcribe recordings larger than 25 MB.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
LECTURE_RECORDING_MAX_BYTES=524288000

# Billing — Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to
# hide online checkout. Webhook URL: <api-host>/api/billing/webhook/razorpay/
# (events: payment.captured, order.paid, payment.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_PRICE_STANDARD_PAISE=299900
BILLING_PRICE_PRO_PAISE=799900
# Block AI calls when a school uses its plan's monthly token allowance
BILLING_ENFORCE_AI_QUOTA=True
# Cost estimates for the usage dashboard (USD)
# LLM_PRICING_USD_PER_MTOK={"deepseek-v4-flash": [0.27, 1.10], "default": [0.5, 1.5]}
OCR_COST_USD_PER_PAGE=0.0015
TRANSCRIPTION_COST_USD_PER_MINUTE=0.0007
